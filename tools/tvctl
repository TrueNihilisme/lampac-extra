#!/bin/sh
# tvctl — send commands to a Lampa client plugin through the Lampac module EX.TvCtl and read its reports.
#
#   export LAMPAC=http://your-lampac:9118      # Lampac address
#   export LAMPAC_PASSWD=...                   # Lampac root password (file <Lampac>/passwd)
#
#   tvctl devices                              which devices are polling
#   tvctl cmd '{"cmd":"state"}' [DEVICE]       queue a command (default device: TVCTL_DEV or the first one polling)
#   tvctl log [N]                              last N reports (default 30)
#
# Examples:
#   tvctl cmd '{"cmd":"open","id":209867,"type":"tv"}'
#   tvctl cmd '{"cmd":"online"}'; tvctl cmd '{"cmd":"items"}'; tvctl cmd '{"cmd":"click","index":5}'
#   tvctl log 20
set -eu
: "${LAMPAC:?set LAMPAC=http://host:port}"
: "${LAMPAC_PASSWD:?set LAMPAC_PASSWD (Lampac root password)}"
api() { curl -fsS --cookie "accspasswd=$LAMPAC_PASSWD" "$@"; }

# Lampac (in Docker) writes times in UTC; show them in the local time zone of this computer.
utc2local() {
  awk -v off="$(date +%z)" 'BEGIN { s = substr(off, 1, 1) == "-" ? -1 : 1; o = s * (substr(off, 2, 2) * 3600 + substr(off, 4, 2) * 60) }
  { if (match($0, /[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/)) { t = substr($0, RSTART, 8)
      x = (substr(t, 1, 2) * 3600 + substr(t, 4, 2) * 60 + substr(t, 7, 2) + o + 86400) % 86400
      $0 = substr($0, 1, RSTART - 1) sprintf("%02d:%02d:%02d", int(x / 3600), int((x % 3600) / 60), x % 60) substr($0, RSTART + 8) }
    print }'
}

case "${1:-}" in
  devices) api "$LAMPAC/tvctl/devices" | utc2local; echo ;;
  log)     api "$LAMPAC/tvctl/log?last=${2:-30}" | utc2local; echo ;;
  cmd)
    [ -n "${2:-}" ] || { echo "usage: tvctl cmd '<json>' [DEVICE]"; exit 1; }
    dev="${3:-${TVCTL_DEV:-}}"
    [ -n "$dev" ] || dev=$(api "$LAMPAC/tvctl/devices" | head -1 | cut -d' ' -f1)
    [ -n "$dev" ] || { echo "no device is polling — is the plugin installed in Lampa?"; exit 1; }
    printf '%s' "$2" | api -X POST -H 'Content-Type: text/plain' --data-binary @- "$LAMPAC/tvctl/cmd?dev=$dev" -o /dev/null
    echo "queued for $dev" ;;
  *) sed -n 2,16p "$0" ;;
esac
